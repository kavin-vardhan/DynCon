# the UE project: sources, Config and Content are committed, everything the engine
# regenerates is not
unreal/DCDemo/Binaries/
unreal/DCDemo/Intermediate/
unreal/DCDemo/Saved/
unreal/DCDemo/DerivedDataCache/
unreal/DCDemo/Plugins/*/Binaries/
unreal/DCDemo/Plugins/*/Intermediate/
unreal/DCDemo/*.sln
unreal/DCDemo/.vs/
unreal/DCDemo/.vsconfig
unreal/DCDemo/Build/Windows/FileOpenOrder/

# build outputs and the packs cut out of them (rebuilt by the package run)
unreal/_build/
unreal/_packs/
