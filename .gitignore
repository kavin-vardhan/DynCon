_mailbox/
_to_delete/
__pycache__/
*.pyc
*.blend1
Thumbs.db
desktop.ini

# generated art: the per-piece previews and QA close-ups regenerate from the scripts,
# so only the three sheets in art/previews/ are committed
art/_qa/
art/previews/*_ext.png
art/previews/*_int.png
art/previews/*_top.png
!art/previews/contact_sheet.png
!art/previews/contact_ext.png
!art/previews/swap_pairs.png
!art/previews/env_contact.png

# the environment kit's per-piece previews, same rule: two palettes x 23 pieces of PNG
# regenerate from art/build.ps1 -EnvOnly; art/previews/env_contact.png is the one that stays
art/previews_env/

# the UE project: sources, Config and Content are committed, everything the engine
# regenerates is not
unreal/DCDemo/Binaries/
unreal/DCDemo/Intermediate/
unreal/DCDemo/Saved/
unreal/DCDemo/DerivedDataCache/
unreal/DCDemo/Plugins/*/Binaries/
unreal/DCDemo/Plugins/*/Intermediate/
unreal/DCDemo/*.sln
unreal/DCDemo/.vs/
unreal/DCDemo/.vsconfig
unreal/DCDemo/Build/Windows/FileOpenOrder/

# build outputs and the packs cut out of them (rebuilt by the package run)
unreal/_build/
unreal/_packs/

# a packaged run writes two ~1 MB screenshots per pack; only the contact sheet built from
# them goes in git (unreal/spike/shots/004/ is brief 004's evidence and stays)
unreal/spike/shots/*.png
!unreal/spike/shots/engine_contact.png
unreal/spike/shots/spike_result.txt

# the demo server: the venv, everything it generates (keys, sqlite, stored packs, client
# caches) and the generated .dcpack files. The generator is committed, the packs are not.
server/.venv/
server/data/
server/demo_files/*.dcpack
server/.pytest_cache/

# the portal's exit-test screenshots: same rule as the art previews — the per-screen PNGs
# are 5 MB a run and `booth\portal_exit_test.py` rebuilds all of them in under a minute,
# so only the contact sheet goes in git.
portal/_shots/*/[0-9]*.png
portal/_shots/*/*.log
portal/_shots/*/audit.txt
!portal/_shots/*/contact_sheet.png
