{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.1",
	"FriendlyName": "DynamicContents",
	"Description": "Runtime dynamic content: content packs mounted and spawned into fixed slots while the game is running.",
	"Category": "DynamicContents",
	"CreatedBy": "",
	"CreatedByURL": "",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
	"EnabledByDefault": true,
	"CanContainContent": false,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "DynamicContents",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"_comment": "The engine's own crypto: IPlatformCrypto::CreateContext gives the OpenSSL-backed FEncryptionContext this plugin verifies RS256 manifests and hashes pack files with (see Public/DCCrypto.h). It is EnabledByDefault, but saying so here is what stops UnrealBuildTool warning that a module dependency crosses a plugin boundary the descriptor does not declare.",
			"Name": "PlatformCrypto",
			"Enabled": true
		}
	]
}
